[Desktop Entry]
Type=Application
Name=File Tools
GenericName=Image Tools
Comment=Background removal, effects, halftone, ASCII art, PDF tools and more
Exec=file-tools %f
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;image/tiff;image/x-icon;image/avif;
Icon=dev.local.filetools
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=image;background;remove;halftone;ascii;convert;pdf;outline;
StartupWMClass=dev.local.filetools
